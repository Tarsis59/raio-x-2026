# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).
# Em produção, os mesmos valores são cadastrados como "Secrets" no GitHub Actions.

# --- Banco (Supabase) --------------------------------------------------------
# Local (padrão): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Produção: Supabase > Project Settings > Database > Connection string (URI, "Session pooler")
DATABASE_URL=

# Segredo para gerar o HMAC do CPF (identidade entre eleições). Gere um valor aleatório longo
# (ex.: python -c "import secrets; print(secrets.token_hex(32))") e NUNCA troque depois.
CPF_HMAC_SECRET=

# --- IA (paga) -----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Evidências permanentes (gratuito) -------------------------------------------
# Crie uma conta em https://archive.org e gere as chaves em https://archive.org/account/s3.php
IA_S3_ACCESS_KEY=
IA_S3_SECRET_KEY=
# 1 = envia as cópias ao archive.org (produção). 0 = só cache local (desenvolvimento).
RAIOX_ARQUIVAR=0

# --- Checagens (gratuito) ------------------------------------------------------
# Google Cloud Console > APIs > "Fact Check Tools API" > Credenciais > Chave de API
GOOGLE_FACTCHECK_API_KEY=

# --- Emendas parlamentares (gratuito) ------------------------------------------
# Cadastro por e-mail: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=

# --- DataJud / CNJ (gratuito) ------------------------------------------------------
# Chave pública publicada em https://datajud-wiki.cnj.jus.br/api-publica/acesso (opcional: o ETL já tem fallback)
DATAJUD_API_KEY=

# --- Site (Cloudflare Pages, gratuito) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare > Turnstile > Add site (chave pública do widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# URL da Edge Function de correções (Supabase > Edge Functions > correcao)
NEXT_PUBLIC_CORRECAO_URL=
# Cloudflare > Web Analytics (opcional, sem cookies)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Deploy (usado só no GitHub Actions) -----------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TURNSTILE_SECRET_KEY=
